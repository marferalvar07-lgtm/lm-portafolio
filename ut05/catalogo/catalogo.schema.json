{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo BiciRuta (catalogo.json)",
  "type": "object",
  "required": ["catalogo", "productos"],
  "additionalProperties": false,
  "properties": {
    "catalogo": {
      "type": "object",
      "required": ["tienda", "actualizado"],
      "properties": {
        "tienda":      { "type": "string", "minLength": 1 },
        "actualizado": { "type": "string", "format": "date" }
      }
    },
    "productos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/producto" }
    }
  },
  "$defs": {
    "producto": {
      "type": "object",
      "required": ["ref", "categoria", "nombre", "precio", "stock"],
      "additionalProperties": false,
      "properties": {
        "ref":       { "type": "string", "pattern": "^BR-[0-9]{4}$" },
        "categoria": { "enum": ["bicicleta", "accesorio", "recambio"] },
        "proveedor": { "type": "string" },
        "nombre":    { "type": "string", "minLength": 1 },
        "precio": {
          "type": "object",
          "required": ["importe"],
          "properties": {
            "importe": { "type": "number", "exclusiveMinimum": 0 },
            "moneda":  { "enum": ["EUR", "USD"], "default": "EUR" }
          }
        },
        "stock":       { "type": "integer", "minimum": 0 },
        "descripcion": { "type": "string" },
        "caracteristicas": {
          "type": "object",
          "properties": {
            "talla": { "enum": ["S", "M", "L", "XL"] },
            "peso": {
              "type": "object",
              "required": ["valor"],
              "properties": {
                "valor":  { "type": "number", "exclusiveMinimum": 0 },
                "unidad": { "const": "kg" }
              }
            }
          }
        }
      }
    }
  }
}
